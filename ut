#!/usr/bin/env bash
# ut — unix-toolkit repo manager
# usage: ut <command> [args]  -- run ut without args for full command list
set -eu

G='\033[32m'; Y='\033[33m'; R='\033[31m'; C='\033[36m'; B='\033[1m'; Z='\033[0m'
ok()   { printf "${G}✓ %s${Z}\n" "$*"; }
warn() { printf "${Y}⚠ %s${Z}\n" "$*"; }
err()  { printf "${R}✗ %s${Z}\n" "$*" >&2; }
info() { printf "${C}→ %s${Z}\n" "$*"; }
bold() { printf "${B}%s${Z}\n" "$*"; }

GITHUB_USER="catwilo"
DST="${UNIX_TOOLKIT_TOOLS:-$HOME/unix-toolkit-tools}"
TSV="${UT_HOME:-$(dirname "$(realpath "$0")")}/repos.tsv"
[ -f "$TSV" ] || TSV="$HOME/unix-toolkit-tools/ut/repos.tsv"

die() { err "$*"; exit 1; }

[ -f "$TSV" ] || die "repos.tsv not found at $TSV"

LIB_UT="$(dirname "$(realpath "$0")")/lib-ut"
for _lib in changelog query status sync registry admin nodes identity; do
    . "$LIB_UT/$_lib.sh"
done

[ $# -gt 0 ] && { CMD="$1"; shift; } || CMD=""
case "$CMD" in -h|--help|help) CMD="" ;; esac
print_help() {
  printf "\nut -- gestor de repos de unix-toolkit-tools\n\n"
  printf "  Cada comando ejecuta una secuencia git completa y muestra el cmd\n"
  printf "  exacto que corrio. Mas rapido y seguro que git manual: un solo\n"
  printf "  comando reemplaza fetch+rebase+checkout+merge+push+delete.\n\n"
  printf "  forma general:  ut <comando> [argumentos]\n"
  printf "  un \"tag\" es una etiqueta del repo (core, tool, client...)\n"
  printf "  definida al registrarlo; varios comandos aceptan un tag para filtrar.\n"
  printf "\n  NOTA: ut gestiona REPOSITORIOS git, NO tareas ni proyectos. Un repo\n"
  printf "  registrado aqui puede no tener ningun bucket de tareas en miko, y un\n"
  printf "  proyecto de miko (~/.tasks/<nombre>) puede no tener repo aqui. Son\n"
  printf "  dos sistemas independientes que a veces comparten nombre.\n"
  printf "\nLEER (sobre todos los repos)\n"
  printf "  ut list                      -- lista todos los repos registrados\n"
  printf "  ut list core                 -- lista solo los que tienen el tag 'core'\n"
  printf "  ut list cloud                -- lista todo lo que existe en GitHub\n"
  printf "  ut list local                -- lista lo clonado en este dispositivo\n"
  printf "  ut list orphans              -- clones locales no registrados en repos.tsv\n"
  printf "  ut status                    -- git status + salud + branches no mergeadas en cada repo\n"
  printf "  ut status --remote           -- igual, mas chequeo de conectividad al remoto\n"
  printf "  ut diff                      -- git diff en cada repo clonado\n"
  printf "  ut fetch                     -- git fetch en cada repo\n"
  printf "\nGIT (sobre todos los repos)\n"
  printf "  ut sync [tag]                -- auto-actualiza ut, sincroniza todos o solo el tag dado\n"
  printf "  ut push                      -- sube los repos con commits pendientes\n"
  printf "  ut run '<comando>'           -- corre el comando en todos los repos\n"
  printf "  ut run '<comando>' core      -- igual, pero solo en los del tag 'core'\n"
  printf "\nGIT (sobre un repo)\n"
  printf "  ut clone                     -- clona todos los repos registrados\n"
  printf "  ut clone core                -- clona solo los del tag 'core'\n"
  printf "  ut install <repo>           -- clona un repo registrado que no esta local aun\n"
  printf "  ut branch <repo> <rama>      -- pull+rebase y crea la rama en ese repo\n"
  printf "                                  ej: ut branch clipso fix/altg\n"
  printf "  ut ship <repo>               -- rebase+merge+push y borra la rama\n"
  printf "                                  ej: ut ship clipso\n"
  printf "\nREGISTRO (edita repos.tsv)\n"
  printf "  ut add <repo> <tags> '<desc>'  -- registra un repo nuevo\n"
  printf "                                  ej: ut add miau-dio audio 'sintesis CLI'\n"
  printf "  ut untrack <repo>            -- quita el repo de repos.tsv (no toca clon ni GitHub)\n"
  printf "  ut unclone <repo>            -- mueve el clon local a trash (no toca repos.tsv ni GitHub)\n"
  printf "  ut tag <repo> +<tag>         -- agrega un tag     ej: ut tag clipso +core\n"
  printf "  ut tag <repo> -<tag>         -- quita un tag      ej: ut tag clipso -core\n"
  printf "  ut pause <repo>              -- marca el repo como pausado\n"
  printf "  ut resume <repo>             -- marca el repo como activo\n"
  printf "  ut archive <repo>            -- marca el repo como archivado\n"
  printf "  ut info <repo>               -- muestra los datos del repo\n"
  printf "\nGITHUB  [destructivo -- modifica GitHub]\n"
  printf "  ut new <repo> <tags> '<desc>'     -- crea repo + clona + sincroniza en todos los nodos\n"
  printf "  ut create <repo> <tags> '<desc>'  -- crea el repo en GitHub\n"
  printf "  ut delete <repo>             -- borra el repo en GitHub\n"
  printf "  ut rename <viejo> <nuevo>    -- renombra el repo en GitHub\n"
  printf "\nNODOS (varias maquinas)\n"
  printf "  ut machines                  -- ping a todos los nodos registrados\n"
  printf "  ut machines diff             -- compara el estado de repos entre nodos\n"
  printf "  ut distribute <repo>         -- copia el repo a los nodos remotos\n"
  printf "  ut deploy <repo>             -- corre install.sh local + distribute\n"
  printf "                                  (si el repo no tiene install.sh, usa\n"
  printf "                                   solo 'ut ship'; 'ut info <repo>' lo dice)\n"
  printf "  ut deploy all                -- igual, pero solo en repos con tag 'core'\n"
  printf "                                  (los demas: 'ut deploy <repo>' manual)\n"
  printf "  ut distribute --no-install <repo>    -- copia el repo a los nodos, sin instalar\n"
  printf "\nFLUJO ESTANDAR de un fix\n"
  printf "  1. ut branch <repo> fix/nombre  -- pull+rebase + crea la rama\n"
  printf "                                     (autostash automatico: si hay\n"
  printf "                                     cambios sin commit, los guarda\n"
  printf "                                     antes y los restaura despues)\n"
  printf "  2. editar los archivos\n"
  printf "  3. verificar el cambio          (confirmas que esta bien)\n"
  printf "  4. ut ship <repo>               -- rebase+merge+push a main, borra la rama\n"
  printf "  5. [PREGUNTA] deployar ahora? [y/N]\n"
  printf "     y -> ut deploy <repo>        (omitir si el repo no tiene install.sh)\n"
  printf "     N -> continuar sin deploy\n"
  printf "  6. [PREGUNTA] sincronizar tareas de miko ahora? [y/N]\n"
  printf "     y -> miko sync\n"
  printf "     N -> continuar sin sync\n\n"
}

[ -z "$CMD" ] && { print_help; exit 0; }

case "$CMD" in
    new)      cmd_new      "$@" ;;
    sync)     cmd_sync     "$@" ;;
    fetch)    cmd_fetch    "$@" ;;
    status)   cmd_status   "$@" ;;
    push)     cmd_push     "$@" ;;
    run)      cmd_run      "$@" ;;
    list)     cmd_list     "$@" ;;
    clone)    cmd_clone    "$@" ;;
    install)  cmd_install  "$@" ;;
    diff)     cmd_diff     "$@" ;;
    tag)      cmd_tag      "$@" ;;
    add)      cmd_add      "$@" ;;
    untrack)  cmd_untrack  "$@" ;;
    unclone)  cmd_unclone  "$@" ;;
    rm)       cmd_rm       "$@" ;;
    remove)   cmd_remove   "$@" ;;
    machines) cmd_machines "$@" ;;
    pause)    cmd_pause    "$@" ;;
    resume)   cmd_resume   "$@" ;;
    archive)  cmd_archive  "$@" ;;
    create)     cmd_create     "$@" ;;
    delete)     cmd_delete     "$@" ;;
    rename)     cmd_rename     "$@" ;;
    info)       cmd_info       "$@" ;;
    ship)       cmd_ship       "$@" ;;
    branch)     cmd_branch     "$@" ;;
    distribute)
        if [ "${2:-}" = "--no-install" ]; then
            shift 2
            cmd_distribute_no_install "$@"
        else
            cmd_distribute "$@"
        fi
        ;;
    deploy)     cmd_deploy     "$@" ;;
    *) err "unknown command: $CMD"; print_help; exit 1 ;;
esac
